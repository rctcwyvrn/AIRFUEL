# gdlint config (gdtoolkit). Run from the repo root: gdlint game/src
#
# class-definitions-order is disabled deliberately: scripts group vars
# thematically (see player.gd's state blocks and its sidecar) instead of
# by const/export/var kind. Everything else is gdlint defaults.
disable:
  - class-definitions-order

# network.gd (the whole Net autoload: LAN, lobby client, match plumbing)
# sits just over the default 1000 after gdformat. player.gd was the other
# offender until it was split into player_movement/combat/recorder
# (2026-09-10) — split network.gd too if it grows past this.
max-file-lines: 1200
